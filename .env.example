# LegalDocs Manager - Environment Variables
# Copy this file to .env and update with your actual values

# ===========================================
# Django Settings
# ===========================================

# SECURITY WARNING: Generate a new secret key for production!
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - set to False in production
DEBUG=True

# Allowed hosts - comma-separated list
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================

DB_NAME=legaldocs_db
DB_USER=legaldocs_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ===========================================
# Production SSL / Let's Encrypt Configuration
# ===========================================

# The production domain name for Nginx and Certbot (use localhost for testing)
DOMAIN_NAME=localhost

# Email for Let's Encrypt renewal notifications
CERTBOT_EMAIL=admin@example.com

# ===========================================
# Object Storage (AWS S3 / MinIO)
# ===========================================
# Enable to offload media files (uploaded documents) to S3/MinIO
USE_S3=False

# S3/MinIO Credentials
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadminsecure
AWS_STORAGE_BUCKET_NAME=legaldocs-media

# Object Storage Endpoint URL
# For AWS S3: leave blank or set to https://s3.amazonaws.com
# For local MinIO: set to http://localhost:9000 (accessible from host machine)
AWS_S3_ENDPOINT_URL=http://localhost:9000

# Object Storage Internal Endpoint URL (only needed for Docker containers)
# For AWS S3: leave blank (falls back to AWS_S3_ENDPOINT_URL)
# For local MinIO: set to http://minio:9000 (accessible within the docker network)
AWS_S3_ENDPOINT_URL_INTERNAL=http://minio:9000

# Optional region name
AWS_S3_REGION_NAME=us-east-1
